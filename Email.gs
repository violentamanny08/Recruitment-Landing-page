// Email.gs - designed new-lead email. Add as a new Script file named Email (uses SHEET_ID and NOTIFY_EMAIL from Code.gs)
var EMAIL_PHOTO = '';
var EMAIL_LOGO = '';

function esc(t) {
  return String(t == null ? '' : t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function sendLeadEmail(d) {
  var score = Number(d.score) || 0;
  var tier = score >= 75 ? 'Strong fit' : score >= 50 ? 'Could be a fit' : 'Not yet';
  var color = score >= 75 ? '#16a34a' : score >= 50 ? '#ff6b00' : '#6b7a8c';
  var to = NOTIFY_EMAIL || Session.getEffectiveUser().getEmail();
  var sheetUrl = 'https://docs.google.com/spreadsheets/d/' + SHEET_ID;
  var tel = String(d.phone || '').replace(/[^0-9+]/g, '');
  var labels = ['PRC license', 'Experience', 'Follow-up habit', 'Weekly hours', 'Income', 'Marketing', 'Resilience', 'Can start'];
  var answers = d.answers || [];
  var cell = 'padding:10px 0;border-bottom:1px solid #e3eaf4;font:14px Arial,sans-serif;';
  var rows = answers.map(function (a, i) {
    return '<tr><td style="' + cell + 'color:#6b7a8c;width:38%;vertical-align:top">' + esc(labels[i] || 'Question ' + (i + 1)) +
           '</td><td style="' + cell + 'color:#062b67;font-weight:bold">' + esc(a) + '</td></tr>';
  }).join('');
  var btn = function (href, bg, fg, text) {
    return '<a href="' + href + '" style="display:inline-block;background:' + bg + ';color:' + fg +
           ';font:bold 14px Arial,sans-serif;text-decoration:none;padding:12px 22px;border-radius:24px;margin:0 6px 8px 0">' + text + '</a>';
  };
  var html =
    '<div style="background:#eef3fa;padding:24px 10px">' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden">' +
    '<tr><td style="background:#031a3f;padding:16px 24px"><img src="cid:logo" width="44" height="44" alt="" style="vertical-align:middle;border-radius:22px"> ' +
    '<span style="font:bold 18px Arial,sans-serif;color:#ffffff;vertical-align:middle;margin-left:10px">Home Partners PH</span></td></tr>' +
    '<tr><td><img src="cid:photo" width="600" alt="Manny and Annalyn" style="display:block;width:100%;max-width:600px;height:auto"></td></tr>' +
    '<tr><td style="background:#ff6b00;height:5px;font-size:0;line-height:0">&nbsp;</td></tr>' +
    '<tr><td style="padding:28px 24px 8px">' +
    '<div style="font:bold 13px Arial,sans-serif;color:#ff6b00">NEW AGENT APPLICANT</div>' +
    '<div style="font:bold 26px Arial,sans-serif;color:#062b67;margin:6px 0 14px">' + esc(d.name) + '</div>' +
    '<table role="presentation" cellpadding="0" cellspacing="0"><tr>' +
    '<td style="background:' + color + ';color:#ffffff;font:bold 28px Arial,sans-serif;padding:10px 18px;border-radius:12px">' + score + '<span style="font-size:14px"> / 100</span></td>' +
    '<td style="padding-left:14px;font:bold 17px Arial,sans-serif;color:' + color + '">' + tier + '</td></tr></table></td></tr>' +
    '<tr><td style="padding:16px 24px 0"><table role="presentation" width="100%" cellpadding="0" cellspacing="0">' +
    '<tr><td style="' + cell + 'color:#6b7a8c;width:38%">Mobile</td><td style="' + cell + 'color:#062b67;font-weight:bold">' + esc(d.phone) + '</td></tr>' +
    '<tr><td style="' + cell + 'color:#6b7a8c">Email</td><td style="' + cell + 'color:#062b67;font-weight:bold">' + esc(d.email) + '</td></tr>' +
    '<tr><td style="' + cell + 'color:#6b7a8c">City</td><td style="' + cell + 'color:#062b67;font-weight:bold">' + esc(d.city) + '</td></tr>' +
    '<tr><td style="' + cell + 'color:#6b7a8c">Source</td><td style="' + cell + 'color:#062b67;font-weight:bold">' + esc(d.source || 'direct') + (d.language === 'tl' ? ' &middot; Tagalog' : '') + '</td></tr>' +
    '</table></td></tr>' +
    '<tr><td style="padding:22px 24px 0"><div style="font:bold 16px Arial,sans-serif;color:#062b67">Quiz answers</div>' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0">' + rows + '</table></td></tr>' +
    '<tr><td style="padding:24px 24px 20px">' +
    btn('tel:' + tel, '#ff6b00', '#031a3f', 'Call now') +
    btn('mailto:' + esc(d.email), '#062b67', '#ffffff', 'Send email') +
    btn(sheetUrl, '#16a34a', '#ffffff', 'Open lead sheet') + '</td></tr>' +
    '<tr><td style="background:#031a3f;padding:14px 24px;font:12px Arial,sans-serif;color:#b9c9de;text-align:center">' +
    'Home Partners PH &middot; Real Life Partners &middot; Real Service &middot; Hassle-Free</td></tr>' +
    '</table></div>';
  var text = 'New agent applicant: ' + d.name + '\nScore: ' + score + '/100 (' + tier + ')\nMobile: ' + d.phone +
             '\nEmail: ' + d.email + '\nCity: ' + d.city + '\n\nAnswers:\n' + answers.join('\n');
  MailApp.sendEmail({
    to: to,
    subject: 'New agent applicant: ' + d.name + ' (' + score + '/100, ' + tier + ')',
    body: text,
    htmlBody: html,
    name: 'Home Partners PH Recruitment',
    inlineImages: {
      photo: Utilities.newBlob(Utilities.base64Decode(EMAIL_PHOTO), 'image/jpeg', 'photo.jpg'),
      logo: Utilities.newBlob(Utilities.base64Decode(EMAIL_LOGO), 'image/jpeg', 'logo.jpg')
    }
  });
}

// Run this from the editor to preview the email without answering the quiz
function testLeadEmail() {
  sendLeadEmail({name: 'Test Applicant', phone: '09123456789', email: 'test@example.com', city: 'General Trias, Cavite', score: 82,
    answers: ['I hold a PRC license', 'Message them the next day with a useful listing or update', '15 to 29 hours',
              'I have savings or other income for the first few months', 'I post and answer inquiries regularly', 'A long-term career I can grow', 'Within 2 weeks']});
}
